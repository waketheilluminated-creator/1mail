OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_TITLE=1Mail Prototype
OPENROUTER_APP_URL=http://127.0.0.1:4173
OPENROUTER_TIMEOUT_MS=20000
CLASSIFICATION_HISTORY_PATH=server/data/classification-history.json
PORT=8787

# Optional backend Gmail OAuth test flow.
# Create a Google Cloud OAuth client of type "Web application".
# Authorized redirect URI:
#   http://localhost:8787/api/gmail/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/gmail/callback
